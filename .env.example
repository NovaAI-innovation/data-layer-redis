# data-layer-redis — non-secret env template
# Real secrets belong in .a0proj/secrets.env (mode 0600, not committed).

# Connection — used by lib/install.sh for verify/status
DATA_LAYER_REDIS_URL=redis://localhost:6379/0

# Default tenant-prefix key namespace. Per-tenant overrides via DATA_LAYER_REDIS_PREFIX_<tenant>=...
DATA_LAYER_REDIS_PREFIX=dl:

# Bypass flag — when "false", cache is treated as miss and queries fall through
DATA_LAYER_REDIS_ENABLED=true

# Bounded TTL (seconds) — values exceeding this are capped at apply time
DATA_LAYER_REDIS_TTL=300