# data-layer-redis — non-secret env template
# Real secrets belong in .a0proj/secrets.env (mode 0600, not committed).

# Connection — used by lib/install.sh and tests/smoke.sh.
# The az-redis container listens on host 127.0.0.1:6380 via docker
# port forwarding (mapped from container 6379). Override per environment.
# Examples:
#   local docker:     redis://127.0.0.1:6380/0
#   Tailscale peer:   redis://<tailscale-ip>:6380/0
#   compose stack:    redis://redis:6379/0
#   test sandbox:     redis://falkordb-test-sandbox:6379/0 (NOT recommended;
#                     mixes cache with falkordb graph keyspace)
DATA_LAYER_REDIS_URL=redis://127.0.0.1:6380/0

# Default tenant-prefix key namespace. Per-tenant overrides via
# DATA_LAYER_REDIS_PREFIX_<tenant>=...
DATA_LAYER_REDIS_PREFIX=dl:

# Bypass flag — when "false", cache is treated as miss and queries fall through
DATA_LAYER_REDIS_ENABLED=true

# Bounded TTL (seconds) — values exceeding this are capped at apply time
DATA_LAYER_REDIS_TTL=300

# az-redis container flags (set at docker run time, NOT in lib/install.sh).
# See README.md "Container flags" for the full list.
# AZ_REDIS_IMAGE=redis:7.2-alpine
# AZ_REDIS_CONTAINER=az-redis
# AZ_REDIS_VOLUME=az-redis-data
# AZ_REDIS_PORT=6380
